# === İstemci (Vite) — yalnızca VITE_* tarayıcıya gider ===
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === Asla VITE_ ile öneklemeyin / asla istemciye koymayın ===
# Bu değerler yalnızca Vercel/Supabase Edge / CI secrets olarak tutulur:
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=FocusProLab <noreply@your-domain.com>
# APP_ORIGIN=https://your-production-domain.com

# Ortam ayrımı (önerilen):
# - local:     bu .env (git’e girmez)
# - staging:   ayrı Supabase projesi + Vercel Preview env
# - production: ayrı Supabase projesi + Vercel Production env
